-- [[ ระบบล็อกมุมกล้องแบบเนียนตา (Smooth Camera Lock) ]] --
RunService.RenderStepped:Connect(function()
    if _G.AimbotEnabled then
        local target = getClosestPlayer()
        if target and target.Character then
            local targetPart = target.Character:FindFirstChild(_G.TargetPart)
            if targetPart then
                -- หมุนกล้องหันไปหาเป้าหมายอย่างสมูท (Lerp CFrame)
                local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, _G.Smoothness)
            end
        end
    end
end)
